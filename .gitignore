# The private half. It normally lives in $HOME (~/.zshrc-user.sh), but ignore
# it here too so a copy kept beside the clone can never be committed.
.zshrc-user.sh
user.sh
powershell/user.ps1
powershell/profile-user.ps1

# macOS
.DS_Store
._*

# Windows
Thumbs.db

# Local troubleshooting copies of a user settings file — never committed.
zshrc-user-example*
zshrc-user.sh

# Editor scratch. A vim swap file was committed on 2026-08-20 by a `git add -A`
# that swept up whatever happened to be in the tree — in a PUBLIC repo. Ignore
# the whole class so it cannot happen again.
*.swp
*.swo
*~
*.orig
*.rej

# Agent and MCP tool scratch. Playwright-MCP writes browser console logs and
# page snapshots into .playwright-mcp/ under whatever directory the session
# happens to be in — content from a site that has nothing to do with this repo.
# Same hazard as the swap file above, and this one is worse: the files arrive
# continuously, so the window for a stray `git add -A` is always open, and this
# repository is PUBLIC.
.playwright-mcp/
