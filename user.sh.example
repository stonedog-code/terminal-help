#!/usr/bin/env zsh
#
# user.sh — the private half of terminal-help. NEVER COMMITTED.
#
#   cp user.sh.example user.sh
#   $EDITOR user.sh
#
# This is the only file that knows anything about your machines: hostnames,
# share names, usernames, jump hosts, the internal wiki URL. It is listed in
# .gitignore, so the public repo stays publishable.
#
# Everything here is optional. terminal-help defines four hook names and
# calls them if they exist:
#
#   connect_work      what `connect_work` does on this machine
#   disconnect_work   the reverse
#   get_user_info     your own reference sections, printed on demand
#   user_on_load      what runs on every new shell (the ONLY thing that
#                     prints at startup besides the version line)
#
# The th_* helpers from lib/ui.zsh are available here, so your sections
# look like the built-in ones: th_head, th_sub, th_row, th_note, th_text,
# th_warn, th_ok.  Do NOT put a password in this file — see below.

# ---------------------------------------------------------------------------
# 🔌 Connection: a work share, over SMB
# ---------------------------------------------------------------------------
# No password goes here. macOS stores the share password in the login keychain
# on the first mount and supplies it afterwards; on Linux use a credentials
# file with mode 600 that this file merely points at. A password on disk is a
# plaintext credential with no expiry that every backup will copy.

export SMB_USER="your-username"
export SMB_SERVER="your-host.local"      # or an IP, e.g. 192.168.1.10
export SMB_SHARE="your-share"
export WORK_MOUNT="$HOME/work"

connect_work() {
    if mount | grep -q " on ${WORK_MOUNT} "; then
        th_ok "Already connected at $WORK_MOUNT"
        return 0
    fi
    [[ -d "$WORK_MOUNT" ]] || mkdir -p "$WORK_MOUNT"

    case "$OSTYPE" in
        darwin*)
            mount_smbfs "//$SMB_USER@$SMB_SERVER/$SMB_SHARE" "$WORK_MOUNT" \
                && th_ok "Mounted //$SMB_SERVER/$SMB_SHARE at $WORK_MOUNT" \
                || { th_warn "Mount failed — is $SMB_SERVER reachable? (ping $SMB_SERVER)"; return 1 }
            ;;
        linux*)
            sudo mount -t cifs "//$SMB_SERVER/$SMB_SHARE" "$WORK_MOUNT" \
                -o "username=$SMB_USER,uid=$(id -u),gid=$(id -g)" \
                && th_ok "Mounted //$SMB_SERVER/$SMB_SHARE at $WORK_MOUNT" \
                || { th_warn "Mount failed — needs cifs-utils and sudo"; return 1 }
            ;;
        *)
            th_warn "connect_work has no branch for $OSTYPE"
            return 1
            ;;
    esac
}

disconnect_work() {
    if mount | grep -q " on ${WORK_MOUNT} "; then
        case "$OSTYPE" in
            darwin*) diskutil unmount "$WORK_MOUNT" ;;
            *)       sudo umount "$WORK_MOUNT" ;;
        esac && th_ok "Disconnected $WORK_MOUNT"
    else
        th_text "$WORK_MOUNT is not mounted"
    fi
}

# ---------------------------------------------------------------------------
# 🔒 Your own reference sections
# ---------------------------------------------------------------------------
# Anything you would otherwise keep in a note: internal hostnames, the deploy
# runbook, the one flag you always forget. It is private, so it can be specific.

get_user_info() {
    th_head "🔒" "My machines"
    th_row "Work share:"       "//$SMB_SERVER/$SMB_SHARE as $SMB_USER"
    th_row "Mount point:"      "$WORK_MOUNT"
    if mount | grep -q " on ${WORK_MOUNT} "; then
        th_row "Status:"       "connected"
    else
        th_row "Status:"       "not mounted"
    fi
    th_row "Connect:"          "connect_work    ·    disconnect_work"
    th_row "In Finder:"        "⌘K, then smb://$SMB_SERVER/$SMB_SHARE"

    th_sub "🚀" "Deploys"
    th_row "Staging:"          "./deploy.sh staging"
    th_note "the flag you always forget goes here, where it is private"
}

# ---------------------------------------------------------------------------
# 🏁 What runs on every new shell
# ---------------------------------------------------------------------------
# terminal-help prints only its version line. Whatever else you want at startup
# goes here — and remember every line of it is a line you read all day.

user_on_load() {
    # Mount the share automatically. Comment out if you would rather it were
    # on demand: over a slow or absent network this blocks the prompt.
    # connect_work

    # A one-line status instead, which costs nothing:
    if mount | grep -q " on ${WORK_MOUNT} " 2>/dev/null; then
        th_ok "work share mounted"
    fi
}

# ---------------------------------------------------------------------------
# 🏷 Personal aliases
# ---------------------------------------------------------------------------
# These are a matter of taste, which is exactly why they are not in the repo.

