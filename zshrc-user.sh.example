#!/usr/bin/env zsh
#
# ~/.zshrc-user.sh — YOUR half of the shell. NEVER COMMITTED.
#
# This is a worked example. The real file lives beside your ~/.zshrc, which
# sources it on every shell:
#
#     $EDITOR ~/.zshrc-user.sh
#
# Put everything personal here rather than in ~/.zshrc: aliases, exports, PATH
# entries, functions, hostnames. Two reasons — the terminal-help block in
# ~/.zshrc is rewritten by the installer, and this file is the only one that
# knows anything about your machines.
#
# terminal-help calls two functions if you define them. Both are optional:
#
#   get_user_info     your own reference sections, printed on demand
#   user_on_load      what runs on every new shell (the ONLY thing that
#                     prints at startup besides the version line)
#
# The th_* helpers are available here, so your sections look like the built-in
# ones: th_head, th_sub, th_row, th_note, th_text, th_warn, th_ok.

# ---------------------------------------------------------------------------
# 🏷 Aliases, exports, PATH — the ordinary shell settings
# ---------------------------------------------------------------------------
# These would once have gone in ~/.zshrc. They belong here now, where an
# upgrade cannot disturb them.

# alias ll="ls -la"
# alias gs="git status -sb"
# export EDITOR="vim"
# path=("$HOME/.local/bin" $path)

# ---------------------------------------------------------------------------
# 🔧 Your own functions
# ---------------------------------------------------------------------------
# Anything you would otherwise retype. A function beats an alias as soon as it
# needs an argument in the middle rather than at the end.

# mkcd() { mkdir -p "$1" && cd "$1" }
# serve() { python3 -m http.server "${1:-8000}" }

# ---------------------------------------------------------------------------
# 🔒 Your own reference sections
# ---------------------------------------------------------------------------
# The things you look up every few weeks and never quite remember: internal
# hostnames, a deploy runbook, the flag with the unmemorable name. This is a
# private file, so it can be as specific as you like.

# get_user_info() {
#     th_head "🔒" "My setup"
#     th_row  "Build box:"   "ssh build-01.internal"
#     th_note "only reachable on the VPN"
#     th_row  "Reset the db:" "./scripts/db-reset.sh --seed"
#
#     th_sub  "🚀" "Deploys"
#     th_row  "Staging:"     "./deploy.sh staging"
#     th_note "the flag you always forget goes here, where it is private"
# }

# ---------------------------------------------------------------------------
# 🏁 What runs on every new shell
# ---------------------------------------------------------------------------
# terminal-help prints only its version line. Whatever else you want at startup
# goes here — and remember every line of it is a line you read all day.

# user_on_load() {
#     th_ok "$(date '+%A %H:%M')"
# }
